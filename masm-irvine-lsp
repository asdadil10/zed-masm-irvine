class DocumentSymbols:
    def __init__(self):
        self.procedures = {}  # name -> [line, signature, end_line]
        self.labels = {}      # name -> (line, text)
        self.variables = {}   # name -> (line, type, init_val, col_start, col_end)
        self.constants = {}   # name -> (line, val)

def split_line_comment(line: str):
    """Splits line into code and trailing comment, respecting quotes."""
    in_quote = False
    quote_char = ''
    for i, ch in enumerate(line):
        if ch in ('"', "'"):
            if not in_quote:
                in_quote = True
                quote_char = ch
            elif quote_char == ch:
                in_quote = False
        elif (ch == ';' or ch == '#') and not in_quote:
            return line[:i].rstrip(), line[i:].strip()
    return line.rstrip(), ""

def strip_line_comment(line: str) -> str:
    """Strips comments while respecting quotes."""
    code, _ = split_line_comment(line)
    return code

def parse_document(text: str) -> DocumentSymbols:
    symbols = DocumentSymbols()
    lines = text.split("\n")
    
    proc_start_pattern = re.compile(r"^\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s+PROC\b(.*)$", re.IGNORECASE)
    proc_end_pattern = re.compile(r"^\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s+ENDP\b", re.IGNORECASE)
    label_pattern = re.compile(r"^\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s*:\s*(?:;.*)?$", re.IGNORECASE)
    var_pattern = re.compile(r"^\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s+(BYTE|SBYTE|WORD|SWORD|DWORD|SDWORD|QWORD|REAL4|REAL8|TBYTE)\s+(.*?)(?:;.*)?$", re.IGNORECASE)
    const_pattern = re.compile(r"^\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s+(=|EQU)\s+(.*?)(?:;.*)?$", re.IGNORECASE)

    current_proc = None

    for i, line in enumerate(lines):
        clean = line.strip()
        if not clean or clean.startswith(";") or clean.startswith("#"):
            continue
            
        m_proc = proc_start_pattern.match(line)
        if m_proc:
            name = m_proc.group(1)
            rest = m_proc.group(2).strip()
            symbols.procedures[name] = [i, f"{name} PROC {rest}".strip(), None]
            current_proc = name
            continue

        m_endp = proc_end_pattern.match(line)
        if m_endp:
            endp_name = m_endp.group(1)
            if endp_name in symbols.procedures:
                symbols.procedures[endp_name][2] = i
            elif current_proc and current_proc in symbols.procedures:
                symbols.procedures[current_proc][2] = i
            current_proc = None
            continue

        m_var = var_pattern.match(line)
        if m_var:
            name = m_var.group(1)
            var_type = m_var.group(2).upper()
            val = m_var.group(3).strip()
            col_start = line.find(name)
            col_end = col_start + len(name)
            symbols.variables[name] = (i, var_type, val, col_start, col_end)
            continue

        m_const = const_pattern.match(line)
        if m_const:
            name = m_const.group(1)
            val = m_const.group(3).strip()
            symbols.constants[name] = (i, val)
            continue

        m_lbl = label_pattern.match(line)
        if m_lbl:
            name = m_lbl.group(1)
            symbols.labels[name] = (i, line.strip())
            continue

    return symbols


def format_masm_document(text: str) -> str:
    """Formats an x86 MASM document into the canonical 4-column layout."""
    lines = text.split("\n")
    out = []
    
    var_pattern = re.compile(r"^\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s+(BYTE|SBYTE|WORD|SWORD|DWORD|SDWORD|QWORD|REAL4|REAL8|TBYTE)\b\s*(.*)$", re.IGNORECASE)
    proc_pattern = re.compile(r"^\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s+(PROC|ENDP)\b\s*(.*)$", re.IGNORECASE)
    label_pattern = re.compile(r"^\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s*:\s*$", re.IGNORECASE)
    directive_margin0 = re.compile(r"^\s*(\.[a-zA-Z0-9_]+|INCLUDE|INCLUDELIB|TITLE|END)\b\s*(.*)$", re.IGNORECASE)

    # First pass: find max variable length across data declarations to align types uniformly
    var_lengths = []
    for line in lines:
        code, _ = split_line_comment(line)
        m_var = var_pattern.match(code)
        if m_var:
            var_lengths.append(len(m_var.group(1)))
    
    max_var_len = max(var_lengths) if var_lengths else 10
    # Indent is 4. Type starts at type_col (at least 2 spaces past longest var name, rounded to multiple of 4)
    type_col = max(16, ((4 + max_var_len + 2 + 3) // 4) * 4)
    val_col = type_col + 8

    for line in lines:
        if not line.strip():
            out.append("")
            continue
            
        code, comment = split_line_comment(line)
        has_orig_indent = line.startswith(" ") or line.startswith("\t")
        
        if not code:
            if has_orig_indent:
                out.append("    " + comment)
            else:
                out.append(comment)
            continue

        # 1. Directives at margin 0
        m_dir = directive_margin0.match(code)
        if m_dir:
            dir_name = m_dir.group(1)
            dir_rest = m_dir.group(2).strip()
            if dir_name.lower() in ("include", "includelib", "title", "end"):
                dir_name = dir_name.upper()
            else:
                dir_name = dir_name.lower()
            formatted_code = f"{dir_name} {dir_rest}".rstrip()
            if comment:
                pad = 48 - len(formatted_code)
                formatted_code += (" " * pad if pad > 1 else "  ") + comment
            out.append(formatted_code)
            continue

        # 2. Procedures at margin 0
        m_proc = proc_pattern.match(code)
        if m_proc:
            p_name = m_proc.group(1)
            p_type = m_proc.group(2).upper()
            p_rest = m_proc.group(3).strip()
            formatted_code = f"{p_name} {p_type} {p_rest}".rstrip()
            if comment:
                pad = 48 - len(formatted_code)
                formatted_code += (" " * pad if pad > 1 else "  ") + comment
            out.append(formatted_code)
            continue

        # 3. Labels at margin 0
        m_lbl = label_pattern.match(code)
        if m_lbl:
            formatted_code = f"{m_lbl.group(1)}:"
            if comment:
                pad = 48 - len(formatted_code)
                formatted_code += (" " * pad if pad > 1 else "  ") + comment
            out.append(formatted_code)
            continue

        # 4. Variables in data segment (Uniform vertical alignment)
        m_var = var_pattern.match(code)
        if m_var:
            v_name = m_var.group(1)
            v_type = m_var.group(2).upper()
            v_val = m_var.group(3).strip()
            # Normalize comma spacing outside quotes or at end of string
            if v_val.endswith(",0"):
                v_val = v_val[:-2] + ", 0"
            pad1 = max(1, type_col - 4 - len(v_name))
            pad2 = max(1, val_col - type_col - len(v_type))
            formatted_code = f"    {v_name}{' ' * pad1}{v_type}{' ' * pad2}{v_val}".rstrip()
            if comment:
                pad = 48 - len(formatted_code)
                formatted_code += (" " * pad if pad > 1 else "  ") + comment
            out.append(formatted_code)
            continue

        # 5. Instructions (Col 4 for opcode, Col 12 for operands)
        parts = code.strip().split(None, 1)
        instr = parts[0]
        operands = parts[1].strip() if len(parts) > 1 else ""
        
        # Clean operands spacing around comma and standardize operator casing
        if operands and not ('"' in operands or "'" in operands):
            operands = re.sub(r"\s*,\s*", ", ", operands)
            operands = re.sub(r"\b(offset|ptr|lengthof|sizeof|type)\b", lambda m: m.group(1).upper(), operands, flags=re.IGNORECASE)

        pad_instr = max(1, 12 - 4 - len(instr))
        formatted_code = f"    {instr}{' ' * pad_instr}{operands}".rstrip()
        if comment:
            pad = 48 - len(formatted_code)
            formatted_code += (" " * pad if pad > 1 else "  ") + comment
        out.append(formatted_code)

    return "\n".join(out)


class MasmServer:
    def __init__(self):
        self.documents = {}  # uri -> text
        self.symbols = {}    # uri -> DocumentSymbols

    def get_word_at_pos(self, text: str, line: int, char: int) -> str:
        lines = text.split("\n")
        if line >= len(lines):
            return ""
        cur_line = lines[line]
        if not cur_line:
            return ""
        if char > len(cur_line):
            char = len(cur_line)
        
        # If cursor is at the boundary after a word, look back 1 char
        idx = char
        if idx >= len(cur_line) or not (cur_line[idx].isalnum() or cur_line[idx] in "_@$?"):
            if idx > 0 and (cur_line[idx-1].isalnum() or cur_line[idx-1] in "_@$?"):
                idx -= 1
            else:
                return ""
        
        start = idx
        while start > 0 and (cur_line[start-1].isalnum() or cur_line[start-1] in "_@$?"):
            start -= 1
        end = idx
        while end < len(cur_line) and (cur_line[end].isalnum() or cur_line[end] in "_@$?"):
            end += 1
        return cur_line[start:end]

    def get_line_prefix(self, text: str, line: int, char: int) -> str:
        lines = text.split("\n")
        if line >= len(lines):
            return ""
        return lines[line][:char]

    def compute_diagnostics(self, uri: str) -> list:
        doc = self.documents.get(uri, "")
        if not doc:
            return []

        if uri not in self.symbols or not self.symbols[uri].procedures:
            self.symbols[uri] = parse_document(doc)
        symbols = self.symbols[uri]
        diagnostics = []
        lines = doc.split("\n")

        var_lookup = {k.lower(): (k, v) for k, v in symbols.variables.items()}
        label_lookup = {k.lower(): k for k in symbols.labels.keys()}
        proc_lookup = {k.lower(): k for k in symbols.procedures.keys()}

        vars_printed_with_writestring = set()

        # -------------------------------------------------------------
        # Rule 1 & Rule 2: Irvine String Checks (OFFSET & Null-terminator)
        # -------------------------------------------------------------
        for i, raw_line in enumerate(lines):
            code_line = strip_line_comment(raw_line).strip()
            if not code_line:
                continue

            # Check: mov edx, <symbol> (Missing OFFSET)
            m_mov_edx = re.match(r"^mov\s+edx\s*,\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s*$", code_line, re.IGNORECASE)
            if m_mov_edx:
                target_sym = m_mov_edx.group(1)
                target_sym_lower = target_sym.lower()

                if target_sym_lower in var_lookup:
                    lookahead_found_call = False
                    for next_i in range(i + 1, min(i + 7, len(lines))):
                        next_code = strip_line_comment(lines[next_i]).strip()
                        if not next_code:
                            continue
                        m_call = re.match(r"^call\s+([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\b", next_code, re.IGNORECASE)
                        if m_call and m_call.group(1).lower() in IRVINE_OFFSET_PROCEDURES:
                            lookahead_found_call = m_call.group(1)
                            vars_printed_with_writestring.add(target_sym_lower)
                            break
                        if re.match(r"^(mov|lea|xor)\s+edx\b", next_code, re.IGNORECASE):
                            break

                    if lookahead_found_call:
                        col_start = raw_line.find(target_sym)
                        col_end = col_start + len(target_sym) if col_start != -1 else len(raw_line)
                        diagnostics.append({
                            "range": {
                                "start": {"line": i, "character": col_start if col_start != -1 else 0},
                                "end": {"line": i, "character": col_end}
                            },
                            "severity": 1,  # Error
                            "code": "Irvine-001",
                            "source": "masm-irvine",
                            "message": f"Missing 'OFFSET' operator: When calling {lookahead_found_call}, EDX must receive the memory offset ('mov edx, OFFSET {target_sym}'). Moving '{target_sym}' directly dereferences its value, causing an access violation or crash.",
                            "data": {"symbol": target_sym}
                        })

            m_mov_offset = re.match(r"^mov\s+edx\s*,\s*OFFSET\s+([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s*$", code_line, re.IGNORECASE)
            if m_mov_offset:
                target_sym_lower = m_mov_offset.group(1).lower()
                vars_printed_with_writestring.add(target_sym_lower)

        # Rule 2: Check if strings used with WriteString have trailing null terminator
        for var_lower in vars_printed_with_writestring:
            if var_lower in var_lookup:
                orig_name, (v_line, v_type, v_init, c_start, c_end) = var_lookup[var_lower]
                if v_type in ("BYTE", "SBYTE") and ('"' in v_init or "'" in v_init):
                    clean_init = v_init.strip().rstrip(",")
                    has_null = bool(re.search(r'(?:,\s*(?:0|0h|00h|NULL|0\b))\s*$', clean_init, re.IGNORECASE))
                    if not has_null:
                        diagnostics.append({
                            "range": {
                                "start": {"line": v_line, "character": c_start},
                                "end": {"line": v_line, "character": c_end}
                            },
                            "severity": 2,  # Warning
                            "code": "Irvine-002",
                            "source": "masm-irvine",
                            "message": f"String '{orig_name}' is passed to WriteString but is missing a null terminator (', 0'). WriteString will continue printing arbitrary memory past the buffer until it encounters a null byte.",
                            "data": {"symbol": orig_name, "line": v_line}
                        })

        # -------------------------------------------------------------
        # Rule 3: Operand Size Mismatch & Rule 5: Ambiguous Memory Size
        # -------------------------------------------------------------
        two_op_pattern = re.compile(r"^\s*(mov|add|sub|cmp|test|and|or|xor|adc|sbb|xchg)\s+([^,]+),\s*(.+)$", re.IGNORECASE)
        ambiguous_mem_pattern = re.compile(r"^\s*(mov|add|sub|cmp|and|or|xor)\s+\[([^\]]+)\]\s*,\s*([0-9a-fA-FhHbB]+|-?[0-9]+)\s*$", re.IGNORECASE)

        for i, raw_line in enumerate(lines):
            code_line = strip_line_comment(raw_line).strip()
            if not code_line:
                continue

            # Rule 5: Ambiguous memory operand
            m_ambig = ambiguous_mem_pattern.match(code_line)
            if m_ambig and "ptr" not in code_line.lower():
                diagnostics.append({
                    "range": {
                        "start": {"line": i, "character": 0},
                        "end": {"line": i, "character": len(raw_line)}
                    },
                    "severity": 1,  # Error
                    "code": "MASM-002",
                    "source": "masm-irvine",
                    "message": "Ambiguous memory operand size: Immediate operand lacks an explicit size qualifier. Specify 'BYTE PTR', 'WORD PTR', or 'DWORD PTR' (e.g. 'mov BYTE PTR [esi], 5').",
                    "data": {"line": i}
                })
                continue

            # Rule 3: Two-operand size consistency
            m_two = two_op_pattern.match(code_line)
            if m_two:
                instr = m_two.group(1).lower()
                op1_raw = m_two.group(2).strip()
                op2_raw = m_two.group(3).strip()

                op1_clean = op1_raw.lower()
                op2_clean = op2_raw.lower()

                if "offset" in op2_clean or "ptr" in op1_clean or "ptr" in op2_clean:
                    continue

                # Case 3a: Both operands are registers
                if op1_clean in REG_WIDTHS and op2_clean in REG_WIDTHS:
                    w1 = REG_WIDTHS[op1_clean]
                    w2 = REG_WIDTHS[op2_clean]
                    if w1 != w2:
                        diagnostics.append({
                            "range": {
                                "start": {"line": i, "character": 0},
                                "end": {"line": i, "character": len(raw_line)}
                            },
                            "severity": 1,  # Error
                            "code": "MASM-001",
                            "source": "masm-irvine",
                            "message": f"Operand size mismatch in '{instr.upper()}': '{op1_raw}' is {w1}-bit but '{op2_raw}' is {w2}-bit. Both operands must have matching sizes. (Use MOVZX or MOVSX for zero/sign extension).",
                            "data": {"instr": instr, "op1": op1_raw, "op2": op2_raw, "line": i}
                        })

                # Case 3b: Op1 is register and Op2 is a declared variable
                elif op1_clean in REG_WIDTHS and op2_clean in var_lookup:
                    w1 = REG_WIDTHS[op1_clean]
                    orig_name, (_, v_type, _, _, _) = var_lookup[op2_clean]
                    w2 = VAR_TYPE_WIDTHS.get(v_type)
                    if w2 and w1 != w2:
                        diagnostics.append({
                            "range": {
                                "start": {"line": i, "character": 0},
                                "end": {"line": i, "character": len(raw_line)}
                            },
                            "severity": 1,  # Error
                            "code": "MASM-001",
                            "source": "masm-irvine",
                            "message": f"Operand size mismatch: Register '{op1_raw}' is {w1}-bit but variable '{orig_name}' is {w2}-bit ({v_type}). Use a matching register or type override (e.g. '{v_type} PTR').",
                            "data": {"instr": instr, "op1": op1_raw, "op2": orig_name, "line": i}
                        })

                # Case 3c: Op1 is variable and Op2 is register
                elif op1_clean in var_lookup and op2_clean in REG_WIDTHS:
                    orig_name, (_, v_type, _, _, _) = var_lookup[op1_clean]
                    w1 = VAR_TYPE_WIDTHS.get(v_type)
                    w2 = REG_WIDTHS[op2_clean]
                    if w1 and w1 != w2:
                        diagnostics.append({
                            "range": {
                                "start": {"line": i, "character": 0},
                                "end": {"line": i, "character": len(raw_line)}
                            },
                            "severity": 1,  # Error
                            "code": "MASM-001",
                            "source": "masm-irvine",
                            "message": f"Operand size mismatch: Variable '{orig_name}' is {w1}-bit ({v_type}) but register '{op2_raw}' is {w2}-bit. Use a matching register.",
                            "data": {"instr": instr, "op1": orig_name, "op2": op2_raw, "line": i}
                        })

        # -------------------------------------------------------------
        # Rule 4: Missing exit in main PROC
        # -------------------------------------------------------------
        for proc_name, (p_start, sig, p_end) in symbols.procedures.items():
            if proc_name.lower() in ("main", "_main"):
                end_line = p_end if p_end is not None else len(lines) - 1
                has_exit = False
                for check_i in range(p_start, end_line + 1):
                    code_check = strip_line_comment(lines[check_i]).strip()
                    if re.search(r"\bexit\b", code_check, re.IGNORECASE) or \
                       re.search(r"call\s+ExitProcess\b", code_check, re.IGNORECASE) or \
                       re.search(r"invoke\s+ExitProcess\b", code_check, re.IGNORECASE):
                        has_exit = True
                        break

                if not has_exit and p_end is not None:
                    diagnostics.append({
                        "range": {
                            "start": {"line": p_end, "character": 0},
                            "end": {"line": p_end, "character": len(lines[p_end])}
                        },
                        "severity": 2,  # Warning
                        "code": "Irvine-003",
                        "source": "masm-irvine",
                        "message": f"Procedure '{proc_name}' does not call 'exit' before '{proc_name} ENDP'. Execution will fall through into subsequent memory or procedures.",
                        "data": {"line": p_end}
                    })

        # -------------------------------------------------------------
        # Rule 6: Undefined Jump Label
        # -------------------------------------------------------------
        jump_pattern = re.compile(r"^\s*(jmp|je|jz|jne|jnz|jg|jge|jl|jle|ja|jae|jb|jbe|jc|jnc|jo|jno|js|jns|loop|loope|loopz|loopne|loopnz)\s+([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\s*$", re.IGNORECASE)

        for i, raw_line in enumerate(lines):
            code_line = strip_line_comment(raw_line).strip()
            if not code_line:
                continue

            m_jmp = jump_pattern.match(code_line)
            if m_jmp:
                target = m_jmp.group(2)
                target_lower = target.lower()

                if target_lower in ("$", "$+2", "$-2"):
                    continue

                if target_lower not in label_lookup and target_lower not in proc_lookup:
                    col_start = raw_line.find(target)
                    diagnostics.append({
                        "range": {
                            "start": {"line": i, "character": col_start if col_start != -1 else 0},
                            "end": {"line": i, "character": (col_start + len(target)) if col_start != -1 else len(raw_line)}
                        },
                        "severity": 1,  # Error
                        "code": "MASM-003",
                        "source": "masm-irvine",
                        "message": f"Undefined jump label: Target label '{target}' is not defined in this document."
                    })

        # -------------------------------------------------------------
        # Stage 3: Data-Flow Hazards (EAX overwrite, EDX clobber, Loop ECX)
        # -------------------------------------------------------------

        # Hazard 1: Loop ECX Modification Hazard (Irvine-HAZ-003)
        lbl_map = {k.lower(): v for k, v in symbols.labels.items()}
        for i, raw_line in enumerate(lines):
            code_line = strip_line_comment(raw_line).strip()
            if not code_line:
                continue
            m_loop = re.match(r"^loop\s+([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\b", code_line, re.IGNORECASE)
            if m_loop:
                target = m_loop.group(1).lower()
                if target in lbl_map:
                    start_l = lbl_map[target][0]
                    if start_l < i:
                        for loop_i in range(start_l + 1, i):
                            l_raw = lines[loop_i]
                            l_code = strip_line_comment(l_raw).strip()
                            if re.search(r"\b(mov|add|sub|inc|dec|xor|shr|shl|mul|div)\s+(ecx|cl|ch|cx)\b", l_code, re.IGNORECASE) or \
                               re.search(r"\bcall\s+ReadString\b", l_code, re.IGNORECASE):
                                diagnostics.append({
                                    "range": {
                                        "start": {"line": loop_i, "character": 0},
                                        "end": {"line": loop_i, "character": len(l_raw)}
                                    },
                                    "severity": 2,  # Warning
                                    "code": "Irvine-HAZ-003",
                                    "source": "masm-irvine",
                                    "message": f"Loop Hazard: Modifying ECX inside a loop body (lines {start_l+1}..{i+1}) disrupts the 'LOOP' counter, causing an infinite loop or premature exit.",
                                    "data": {"line": loop_i}
                                })

        # Hazard 2: EDX Clobbered by 32-bit Multiply/Divide (Irvine-HAZ-002)
        for i, raw_line in enumerate(lines):
            code_line = strip_line_comment(raw_line).strip()
            if not code_line:
                continue
            m_edx = re.match(r"^mov\s+edx\s*,\s*OFFSET\s+([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\b", code_line, re.IGNORECASE)
            if m_edx:
                var_name = m_edx.group(1)
                for next_i in range(i + 1, min(i + 10, len(lines))):
                    next_raw = lines[next_i]
                    next_code = strip_line_comment(next_raw).strip()
                    if not next_code:
                        continue
                    if re.match(r"^(mul|div|idiv)\s+([a-zA-Z0-9_@$?\[\]]+)", next_code, re.IGNORECASE):
                        instr = next_code.split()[0].upper()
                        diagnostics.append({
                            "range": {
                                "start": {"line": next_i, "character": 0},
                                "end": {"line": next_i, "character": len(next_raw)}
                            },
                            "severity": 2,  # Warning
                            "code": "Irvine-HAZ-002",
                            "source": "masm-irvine",
                            "message": f"Register Hazard: 32-bit '{instr}' overwrites EDX (used for high 32 bits of EDX:EAX product/remainder). String pointer to '{var_name}' loaded on line {i+1} is destroyed.",
                            "data": {"line": next_i, "var": var_name}
                        })
                        break
                    if re.match(r"^call\s+WriteString\b", next_code, re.IGNORECASE):
                        break
                    if re.match(r"^(mov|lea)\s+edx\b", next_code, re.IGNORECASE):
                        break

        # Hazard 3: EAX Overwritten by ReadInt / ReadString without read (Irvine-HAZ-001)
        for i, raw_line in enumerate(lines):
            code_line = strip_line_comment(raw_line).strip()
            if not code_line:
                continue
            m_eax = re.match(r"^(mov|add|sub|imul)\s+eax\s*,\s*([^\s;]+)", code_line, re.IGNORECASE)
            if m_eax:
                val_loaded = m_eax.group(2)
                for next_i in range(i + 1, min(i + 7, len(lines))):
                    next_raw = lines[next_i]
                    next_code = strip_line_comment(next_raw).strip()
                    if not next_code:
                        continue
                    if re.match(r"^call\s+(ReadString|ReadInt|RandomRange|Random32)\b", next_code, re.IGNORECASE):
                        called_proc = next_code.split()[1]
                        diagnostics.append({
                            "range": {
                                "start": {"line": next_i, "character": 0},
                                "end": {"line": next_i, "character": len(next_raw)}
                            },
                            "severity": 2,  # Warning
                            "code": "Irvine-HAZ-001",
                            "source": "masm-irvine",
                            "message": f"Register Hazard: Calling '{called_proc}' overwrites EAX. Value '{val_loaded}' loaded into EAX on line {i+1} is discarded before being read or saved.",
                            "data": {"line": next_i, "val": val_loaded}
                        })
                        break
                    if re.search(r"\b(mov|push|cmp|add|sub)\s+[^,]+,\s*eax\b", next_code, re.IGNORECASE) or \
                       re.search(r"\bpush\s+eax\b", next_code, re.IGNORECASE):
                        break
                    if re.match(r"^mov\s+eax\b", next_code, re.IGNORECASE):
                        break

        return diagnostics

    def handle_code_action(self, uri: str, range_data: dict, context: dict) -> list:
        """Generates 1-click Quick-Fix proposals for detected diagnostics."""
        doc = self.documents.get(uri, "")
        if not doc:
            return []

        lines = doc.split("\n")
        actions = []
        diagnostics = context.get("diagnostics", [])

        for diag in diagnostics:
            code = diag.get("code")
            d_range = diag.get("range", {})
            start_line = d_range.get("start", {}).get("line", 0)

            # 1. Quick-fix for Irvine-001 (Missing OFFSET)
            if code == "Irvine-001":
                target_sym = diag.get("data", {}).get("symbol")
                if not target_sym and start_line < len(lines):
                    m = re.search(r"mov\s+edx\s*,\s*([a-zA-Z_@$?][a-zA-Z0-9_@$?]*)\b", lines[start_line], re.IGNORECASE)
                    if m:
                        target_sym = m.group(1)

                if target_sym:
                    actions.append({
                        "title": f"💡 Insert 'OFFSET' operator ('mov edx, OFFSET {target_sym}')",
                        "kind": "quickfix",
                        "isPreferred": True,
                        "diagnostics": [diag],
                        "edit": {
                            "changes": {
                                uri: [
                                    {
                                        "range": d_range,
                                        "newText": f"OFFSET {target_sym}"
                                    }
                                ]
                            }
                        }
                    })

            # 2. Quick-fix for Irvine-002 (Unterminated string)
            elif code == "Irvine-002":
                if start_line < len(lines):
                    line_text = lines[start_line]
                    # Find end of string literal
                    m_quote = re.search(r'("[^"]*"|\'[^\']*\')', line_text)
                    if m_quote:
                        insert_pos = m_quote.end()
                        actions.append({
                            "title": "💡 Append null terminator (', 0')",
                            "kind": "quickfix",
                            "isPreferred": True,
                            "diagnostics": [diag],
                            "edit": {
                                "changes": {
                                    uri: [
                                        {
                                            "range": {
                                                "start": {"line": start_line, "character": insert_pos},
                                                "end": {"line": start_line, "character": insert_pos}
                                            },
                                            "newText": ", 0"
                                        }
                                    ]
                                }
                            }
                        })

            # 3. Quick-fix for Irvine-003 (Missing exit before ENDP)
            elif code == "Irvine-003":
                actions.append({
                    "title": "💡 Insert 'exit' before ENDP",
                    "kind": "quickfix",
                    "isPreferred": True,
                    "diagnostics": [diag],
                    "edit": {
                        "changes": {
                            uri: [
                                {
                                    "range": {
                                        "start": {"line": start_line, "character": 0},
                                        "end": {"line": start_line, "character": 0}
                                    },
                                    "newText": "    exit\n"
                                }
                            ]
                        }
                    }
                })

            # 4. Quick-fix for MASM-001 (Size mismatch -> MOVZX / MOVSX)
            elif code == "MASM-001":
                if start_line < len(lines):
                    line_text = lines[start_line]
                    m_mov = re.match(r"^(\s*)mov\b", line_text, re.IGNORECASE)
                    if m_mov:
                        indent = len(m_mov.group(1))
                        actions.append({
                            "title": "💡 Change 'mov' to zero-extending 'movzx'",
                            "kind": "quickfix",
                            "isPreferred": True,
                            "diagnostics": [diag],
                            "edit": {
                                "changes": {
                                    uri: [
                                        {
                                            "range": {
                                                "start": {"line": start_line, "character": indent},
                                                "end": {"line": start_line, "character": indent + 3}
                                            },
                                            "newText": "movzx"
                                        }
                                    ]
                                }
                            }
                        })
                        actions.append({
                            "title": "💡 Change 'mov' to sign-extending 'movsx'",
                            "kind": "quickfix",
                            "isPreferred": False,
                            "diagnostics": [diag],
                            "edit": {
                                "changes": {
                                    uri: [
                                        {
                                            "range": {
                                                "start": {"line": start_line, "character": indent},
                                                "end": {"line": start_line, "character": indent + 3}
                                            },
                                            "newText": "movsx"
                                        }
                                    ]
                                }
                            }
                        })

            # 5. Quick-fix for MASM-002 (Ambiguous memory size)
            elif code == "MASM-002":
                if start_line < len(lines):
                    line_text = lines[start_line]
                    b_idx = line_text.find('[')
                    if b_idx != -1:
                        for ptr_type in ("DWORD PTR ", "BYTE PTR ", "WORD PTR "):
                            actions.append({
                                "title": f"💡 Specify '{ptr_type.strip()}'",
                                "kind": "quickfix",
                                "isPreferred": (ptr_type == "DWORD PTR "),
                                "diagnostics": [diag],
                                "edit": {
                                    "changes": {
                                        uri: [
                                            {
                                                "range": {
                                                    "start": {"line": start_line, "character": b_idx},
                                                    "end": {"line": start_line, "character": b_idx}
                                                },
                                                "newText": ptr_type
                                            }
                                        ]
                                    }
                                }
                            })

            # 6. Quick-fix for Irvine-HAZ-003 (Preserve ECX in loop)
            elif code == "Irvine-HAZ-003":
                if start_line < len(lines):
                    line_text = lines[start_line]
                    indent = len(line_text) - len(line_text.lstrip())
                    sp = " " * indent
                    actions.append({
                        "title": "💡 Preserve ECX using 'push ecx' and 'pop ecx'",
                        "kind": "quickfix",
                        "isPreferred": True,
                        "diagnostics": [diag],
                        "edit": {
                            "changes": {
                                uri: [
                                    {
                                        "range": {"start": {"line": start_line, "character": 0}, "end": {"line": start_line, "character": 0}},
                                        "newText": f"{sp}push ecx\n"
                                    },
                                    {
                                        "range": {"start": {"line": start_line + 1, "character": 0}, "end": {"line": start_line + 1, "character": 0}},
                                        "newText": f"{sp}pop  ecx\n"
                                    }
                                ]
                            }
                        }
                    })

            # 7. Quick-fix for Irvine-HAZ-001 (Preserve EAX around clobbering call)
            elif code == "Irvine-HAZ-001":
                if start_line < len(lines):
                    line_text = lines[start_line]
                    indent = len(line_text) - len(line_text.lstrip())
                    sp = " " * indent
                    actions.append({
                        "title": "💡 Preserve EAX with 'push eax' and 'pop eax'",
                        "kind": "quickfix",
                        "isPreferred": True,
                        "diagnostics": [diag],
                        "edit": {
                            "changes": {
                                uri: [
                                    {
                                        "range": {"start": {"line": start_line, "character": 0}, "end": {"line": start_line, "character": 0}},
                                        "newText": f"{sp}push eax\n"
                                    },
                                    {
                                        "range": {"start": {"line": start_line + 1, "character": 0}, "end": {"line": start_line + 1, "character": 0}},
                                        "newText": f"{sp}pop  eax\n"
                                    }
                                ]
                            }
                        }
                    })

            # 8. Quick-fix for Irvine-HAZ-002 (Preserve EDX pointer around 32-bit MUL/DIV)
            elif code == "Irvine-HAZ-002":
                if start_line < len(lines):
                    line_text = lines[start_line]
                    indent = len(line_text) - len(line_text.lstrip())
                    sp = " " * indent
                    actions.append({
                        "title": "💡 Preserve EDX pointer with 'push edx' and 'pop edx'",
                        "kind": "quickfix",
                        "isPreferred": True,
                        "diagnostics": [diag],
                        "edit": {
                            "changes": {
                                uri: [
                                    {
                                        "range": {"start": {"line": start_line, "character": 0}, "end": {"line": start_line, "character": 0}},
                                        "newText": f"{sp}push edx\n"
                                    },
                                    {
                                        "range": {"start": {"line": start_line + 1, "character": 0}, "end": {"line": start_line + 1, "character": 0}},
                                        "newText": f"{sp}pop  edx\n"
                                    }
                                ]
                            }
                        }
                    })

        return actions

    def handle_formatting(self, uri: str, options: dict) -> list:
        """Formats the entire document according to the canonical 4-column layout."""
        doc = self.documents.get(uri, "")
        if not doc:
            return []

        formatted = format_masm_document(doc)
        if formatted == doc:
            return []

        lines = doc.split("\n")
        last_line = len(lines) - 1
        last_char = len(lines[-1]) if lines else 0

        return [
            {
                "range": {
                    "start": {"line": 0, "character": 0},
                    "end": {"line": last_line, "character": last_char}
                },
                "newText": formatted
            }
        ]

    def handle_completion(self, uri: str, line: int, char: int):
        doc = self.documents.get(uri, "")
        prefix = self.get_line_prefix(doc, line, char)
        doc_syms = self.symbols.get(uri, DocumentSymbols())
        
        items = []

        stripped_prefix = prefix.strip()
        is_call = bool(re.search(r"\bcall\s+[a-zA-Z0-9_@$?]*$", prefix, re.IGNORECASE))
        is_offset = bool(re.search(r"\bOFFSET\s+[a-zA-Z0-9_@$?]*$", prefix, re.IGNORECASE))
        is_jump = bool(re.search(r"\bj[a-z]{1,4}\s+[a-zA-Z0-9_@$?]*$", prefix, re.IGNORECASE))
        is_loop = bool(re.search(r"\bloop[a-z]{0,2}\s+[a-zA-Z0-9_@$?]*$", prefix, re.IGNORECASE))

        # 1. Irvine Procedures
        proc_sort_priority = "01" if is_call else "05"
        for name, data in IRVINE_PROCEDURES.items():
            items.append({
                "label": name,
                "kind": 3,  # Function
                "detail": data["detail"],
                "documentation": {"kind": "markdown", "value": data["doc"]},
                "insertText": name,
                "sortText": f"{proc_sort_priority}_{name}"
            })

        # 2. User Procedures
        for name, proc_data in doc_syms.procedures.items():
            l_num = proc_data[0]
            sig = proc_data[1]
            items.append({
                "label": name,
                "kind": 3,  # Function
                "detail": f"User procedure: {sig}",
                "documentation": {"kind": "markdown", "value": f"Defined at line {l_num + 1}:\n```assembly\n{sig}\n```"},
                "insertText": name,
                "sortText": f"02_{name}" if is_call else f"06_{name}"
            })

        # 3. User Variables (High priority if after OFFSET)
        var_sort_priority = "01" if is_offset else "07"
        for name, (l_num, vtype, val, _, _) in doc_syms.variables.items():
            items.append({
                "label": name,
                "kind": 6,  # Variable
                "detail": f"{name} {vtype} {val}",
                "documentation": {"kind": "markdown", "value": f"**Variable** defined at line {l_num + 1}:\n```assembly\n{name} {vtype} {val}\n```"},
                "insertText": name,
                "sortText": f"{var_sort_priority}_{name}"
            })

        # 4. User Labels (High priority if after jump/loop)
        lbl_sort_priority = "01" if (is_jump or is_loop) else "08"
        for name, (l_num, text_lbl) in doc_syms.labels.items():
            items.append({
                "label": name,
                "kind": 7,  # Label / Class
                "detail": f"Label: {name}",
                "documentation": {"kind": "markdown", "value": f"**Jump Label** defined at line {l_num + 1}"},
                "insertText": name,
                "sortText": f"{lbl_sort_priority}_{name}"
            })

        # 5. User Constants
        for name, (l_num, val) in doc_syms.constants.items():
            items.append({
                "label": name,
                "kind": 21,  # Constant
                "detail": f"Constant: {name} = {val}",
                "documentation": {"kind": "markdown", "value": f"Constant defined at line {l_num + 1}:\n`{name} = {val}`"},
                "insertText": name,
                "sortText": f"08_{name}"
            })

        # 6. Irvine Macros
        for name, data in IRVINE_MACROS.items():
            items.append({
                "label": name,
                "kind": 15,  # Snippet
                "detail": data["detail"],
                "documentation": {"kind": "markdown", "value": data["doc"]},
                "insertText": data["snippet"],
                "insertTextFormat": 2,  # Snippet
                "sortText": f"04_{name}"
            })

        # 7. Irvine Colors
        for name, desc in IRVINE_COLORS:
            items.append({
                "label": name,
                "kind": 21,  # Constant
                "detail": f"Irvine32 color: {name}",
                "documentation": {"kind": "markdown", "value": f"**Irvine32 Console Color**\n{desc}"},
                "insertText": name,
                "sortText": f"12_{name}"
            })

        # 8. x86 Registers
        for reg, (role, desc) in X86_REGISTERS.items():
            items.append({
                "label": reg,
                "kind": 6,  # Variable
                "detail": f"Register: {reg.upper()} ({role})",
                "documentation": {"kind": "markdown", "value": f"### `{reg.upper()}`\n**Role:** {role}\n\n{desc}"},
                "insertText": reg,
                "sortText": f"10_{reg}"
            })

        # 9. x86 Instructions
        for instr, (syntax, desc) in X86_INSTRUCTIONS.items():
            items.append({
                "label": instr,
                "kind": 14,  # Keyword
                "detail": syntax,
                "documentation": {"kind": "markdown", "value": f"### `{instr.upper()}`\n**Syntax:** `{syntax}`\n\n{desc}"},
                "insertText": instr,
                "sortText": f"15_{instr}"
            })

        # 10. MASM Directives
        for directive, (syntax, desc) in MASM_DIRECTIVES.items():
            items.append({
                "label": directive,
                "kind": 14,  # Keyword
                "detail": syntax,
                "documentation": {"kind": "markdown", "value": f"### `{directive}`\n{desc}"},
                "insertText": directive,
                "sortText": f"20_{directive}"
            })

        # 11. Templates / Snippets
        for key, t_data in TEMPLATES.items():
            items.append({
                "label": key,
                "kind": 15,  # Snippet
                "detail": t_data["detail"],
                "documentation": {"kind": "markdown", "value": t_data["doc"]},
                "insertText": t_data["snippet"],
                "insertTextFormat": 2,
                "sortText": f"00_{key}"
            })

        return {"isIncomplete": False, "items": items}

    def handle_hover(self, uri: str, line: int, char: int):
        doc = self.documents.get(uri, "")
        word = self.get_word_at_pos(doc, line, char)
        if not word:
            return None

        word_lower = word.lower()

        for name, data in IRVINE_PROCEDURES.items():
            if name.lower() == word_lower:
                return {
                    "contents": {
                        "kind": "markdown",
                        "value": data["doc"]
                    }
                }

        for name, data in IRVINE_MACROS.items():
            if name.lower() == word_lower:
                return {
                    "contents": {
                        "kind": "markdown",
                        "value": data["doc"]
                    }
                }

        for name, desc in IRVINE_COLORS:
            if name.lower() == word_lower:
                return {
                    "contents": {
                        "kind": "markdown",
                        "value": f"### Irvine32 Color: `{name}`\n{desc}"
                    }
                }

        if word_lower in X86_REGISTERS:
            role, desc = X86_REGISTERS[word_lower]
            return {
                "contents": {
                    "kind": "markdown",
                    "value": f"### Register `{word_lower.upper()}`\n**Role:** {role}\n\n{desc}"
                }
            }

        if word_lower in X86_INSTRUCTIONS:
            syntax, desc = X86_INSTRUCTIONS[word_lower]
            return {
                "contents": {
                    "kind": "markdown",
                    "value": f"### Instruction `{word_lower.upper()}`\n**Syntax:** `{syntax}`\n\n{desc}"
                }
            }

        for directive, (syntax, desc) in MASM_DIRECTIVES.items():
            if directive.lower().lstrip(".") == word_lower.lstrip("."):
                return {
                    "contents": {
                        "kind": "markdown",
                        "value": f"### MASM `{directive}`\n{desc}"
                    }
                }

        doc_syms = self.symbols.get(uri, DocumentSymbols())
        for name, proc_data in doc_syms.procedures.items():
            if name.lower() == word_lower:
                l_num = proc_data[0]
                sig = proc_data[1]
                return {
                    "contents": {
                        "kind": "markdown",
                        "value": f"### Procedure `{name}`\nDefined at line {l_num + 1}\n```assembly\n{sig}\n```"
                    }
                }

        for name, (l_num, vtype, val, _, _) in doc_syms.variables.items():
            if name.lower() == word_lower:
                return {
                    "contents": {
                        "kind": "markdown",
                        "value": f"### Variable `{name}`\n**Type:** `{vtype}`\n**Initial Value:** `{val}`\n**Defined at line:** {l_num + 1}"
                    }
                }

        for name, (l_num, text_lbl) in doc_syms.labels.items():
            if name.lower() == word_lower:
                return {
                    "contents": {
                        "kind": "markdown",
                        "value": f"### Label `{name}:`\nDefined at line {l_num + 1}"
                    }
                }

        for name, (l_num, val) in doc_syms.constants.items():
            if name.lower() == word_lower:
                return {
                    "contents": {
                        "kind": "markdown",
                        "value": f"### Constant `{name}`\nValue: `{val}` (line {l_num + 1})"
                    }
                }

        return None

    def handle_definition(self, uri: str, line: int, char: int):
        doc = self.documents.get(uri, "")
        word = self.get_word_at_pos(doc, line, char)
        if not word:
            return None

        word_lower = word.lower()
        doc_syms = self.symbols.get(uri, DocumentSymbols())

        for name, proc_data in doc_syms.procedures.items():
            if name.lower() == word_lower:
                l_num = proc_data[0]
                return {
                    "uri": uri,
                    "range": {
                        "start": {"line": l_num, "character": 0},
                        "end": {"line": l_num, "character": len(name)}
                    }
                }

        for name, (l_num, _, _, c_start, c_end) in doc_syms.variables.items():
            if name.lower() == word_lower:
                return {
                    "uri": uri,
                    "range": {
                        "start": {"line": l_num, "character": c_start},
                        "end": {"line": l_num, "character": c_end}
                    }
                }

        for name, (l_num, _) in doc_syms.labels.items():
            if name.lower() == word_lower:
                return {
                    "uri": uri,
                    "range": {
                        "start": {"line": l_num, "character": 0},
                        "end": {"line": l_num, "character": len(name)}
                    }
                }

        for name, (l_num, _) in doc_syms.constants.items():
            if name.lower() == word_lower:
                return {
                    "uri": uri,
                    "range": {
                        "start": {"line": l_num, "character": 0},
                        "end": {"line": l_num, "character": len(name)}
                    }
                }

        return None

    def handle_document_symbol(self, uri: str):
        doc_syms = self.symbols.get(uri, DocumentSymbols())
        symbols = []

        for name, proc_data in doc_syms.procedures.items():
            l_num = proc_data[0]
            sig = proc_data[1]
            symbols.append({
                "name": name,
                "detail": sig,
                "kind": 12,  # Function
                "range": {
                    "start": {"line": l_num, "character": 0},
                    "end": {"line": l_num, "character": len(sig)}
                },
                "selectionRange": {
                    "start": {"line": l_num, "character": 0},
                    "end": {"line": l_num, "character": len(name)}
                }
            })

        for name, (l_num, vtype, val, c_start, c_end) in doc_syms.variables.items():
            symbols.append({
                "name": name,
                "detail": f"{vtype} {val}",
                "kind": 13,  # Variable
                "range": {
                    "start": {"line": l_num, "character": 0},
                    "end": {"line": l_num, "character": len(name)}
                },
                "selectionRange": {
                    "start": {"line": l_num, "character": c_start},
                    "end": {"line": l_num, "character": c_end}
                }
            })

        for name, (l_num, _) in doc_syms.labels.items():
            symbols.append({
                "name": name,
                "detail": "label",
                "kind": 20,  # Field / Label
                "range": {
                    "start": {"line": l_num, "character": 0},
                    "end": {"line": l_num, "character": len(name)}
                },
                "selectionRange": {
                    "start": {"line": l_num, "character": 0},
                    "end": {"line": l_num, "character": len(name)}
                }
            })

        return symbols


def send_response(resp: dict):
    body = json.dumps(resp)
    header = f"Content-Length: {len(body.encode('utf-8'))}\r\n\r\n"
    sys.stdout.write(header + body)
    sys.stdout.flush()

def send_notification(method: str, params: dict):
    body = json.dumps({
        "jsonrpc": "2.0",
        "method": method,
        "params": params
    })
    header = f"Content-Length: {len(body.encode('utf-8'))}\r\n\r\n"
    sys.stdout.write(header + body)
    sys.stdout.flush()

def main():
    server = MasmServer()
    log_debug("MASM-Irvine LSP started")

    while True:
        try:
            line = sys.stdin.buffer.readline()
            if not line:
                log_debug("STDIN closed (EOF), exiting")
                break
            if line.startswith(b"Content-Length:"):
                content_length = int(line.split(b":")[1].strip())
                while True:
                    empty_line = sys.stdin.buffer.readline()
                    if empty_line in (b"\r\n", b"\n", b""):
                        break
                
                body = sys.stdin.buffer.read(content_length)
                request = json.loads(body.decode("utf-8"))
                
                req_id = request.get("id")
                method = request.get("method")
                params = request.get("params", {})
                log_debug(f"Received request: method={method}, id={req_id}")

                if method == "initialize":
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": {
                            "capabilities": {
                                "textDocumentSync": 1,  # Full sync
                                "completionProvider": {
                                    "triggerCharacters": [" ", ",", ".", ":", "@", "+"],
                                    "resolveProvider": False
                                },
                                "hoverProvider": True,
                                "definitionProvider": True,
                                "documentSymbolProvider": True,
                                "documentFormattingProvider": True,
                                "codeActionProvider": True
                            },
                            "serverInfo": {
                                "name": "masm-irvine-lsp",
                                "version": "1.2.0"
                            }
                        }
                    })

                elif method == "initialized":
                    pass

                elif method == "shutdown":
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": None
                    })

                elif method == "exit":
                    sys.exit(0)

                elif method == "textDocument/didOpen":
                    td = params.get("textDocument", {})
                    uri = td.get("uri")
                    text = td.get("text", "")
                    server.documents[uri] = text
                    server.symbols[uri] = parse_document(text)
                    diags = server.compute_diagnostics(uri)
                    send_notification("textDocument/publishDiagnostics", {
                        "uri": uri,
                        "diagnostics": diags
                    })

                elif method == "textDocument/didChange":
                    td = params.get("textDocument", {})
                    uri = td.get("uri")
                    content_changes = params.get("contentChanges", [])
                    if content_changes:
                        text = content_changes[-1].get("text", "")
                        server.documents[uri] = text
                        server.symbols[uri] = parse_document(text)
                        diags = server.compute_diagnostics(uri)
                        send_notification("textDocument/publishDiagnostics", {
                            "uri": uri,
                            "diagnostics": diags
                        })

                elif method == "textDocument/didClose":
                    td = params.get("textDocument", {})
                    uri = td.get("uri")
                    server.documents.pop(uri, None)
                    server.symbols.pop(uri, None)
                    send_notification("textDocument/publishDiagnostics", {
                        "uri": uri,
                        "diagnostics": []
                    })

                elif method == "textDocument/formatting":
                    td = params.get("textDocument", {})
                    options = params.get("options", {})
                    result = server.handle_formatting(td.get("uri"), options)
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": result
                    })

                elif method == "textDocument/codeAction":
                    td = params.get("textDocument", {})
                    range_data = params.get("range", {})
                    context = params.get("context", {})
                    result = server.handle_code_action(td.get("uri"), range_data, context)
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": result
                    })

                elif method == "textDocument/completion":
                    td = params.get("textDocument", {})
                    pos = params.get("position", {})
                    result = server.handle_completion(td.get("uri"), pos.get("line", 0), pos.get("character", 0))
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": result
                    })

                elif method == "textDocument/hover":
                    td = params.get("textDocument", {})
                    pos = params.get("position", {})
                    result = server.handle_hover(td.get("uri"), pos.get("line", 0), pos.get("character", 0))
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": result
                    })

                elif method == "textDocument/definition":
                    td = params.get("textDocument", {})
                    pos = params.get("position", {})
                    result = server.handle_definition(td.get("uri"), pos.get("line", 0), pos.get("character", 0))
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": result
                    })

                elif method == "textDocument/documentSymbol":
                    td = params.get("textDocument", {})
                    result = server.handle_document_symbol(td.get("uri"))
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": result
                    })

                elif req_id is not None:
                    send_response({
                        "jsonrpc": "2.0",
                        "id": req_id,
                        "result": None
                    })
        except Exception as e:
            log_debug(f"Exception in main loop: {e}")
            import traceback
            log_debug(traceback.format_exc())
            continue

if __name__ == "__main__":
    main()
